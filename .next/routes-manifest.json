  "dynamicRoutes": [
    {
      "page": "/admin/projects/[id]/edit",
      "regex": "^/admin/projects/([^/]+?)/edit(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/projects/(?<nxtPid>[^/]+?)/edit(?:/)?$"
    },
    {
      "page": "/projects/[slug]",
